{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":preserveSemverRanges"],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgePackageManagerSync": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "hk.pkl names hk's pkl packages by release",
      "managerFilePatterns": ["/^hk\\.pkl$/"],
      "matchStrings": [
        "releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@\\d+\\.\\d+\\.\\d+"
      ],
      "autoReplaceStringTemplate": "releases/download/v{{{newValue}}}/hk@{{{newValue}}}",
      "depNameTemplate": "hk",
      "packageNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "the ci standard holds exemplar at @main, unpinned",
      "matchPackageNames": ["fancysnake/exemplar"],
      "enabled": false
    },
    {
      "description": "One PR for all small updates",
      "groupName": "non-major dependencies",
      "groupSlug": "non-major",
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "description": "A 0.x minor can break, so it gets its own PR",
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": ["minor"],
      "groupName": null
    },
    {
      "description": "requires-python allows only 3.14",
      "matchManagers": ["mise"],
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["minor"],
      "enabled": false
    }
  ]
}
