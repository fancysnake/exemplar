amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

// What `mise run lint:py` does not check: the `check` hook, which `lint:hk`
// runs after `lint:py`, so the full sweep runs each linter once.
local sweep: Mapping<String, Step> = new {
  // File hygiene
  ["check-added-large-files"] = Builtins.check_added_large_files
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["detect-private-key"] = Builtins.detect_private_key
  ["end-of-file-fixer"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace

  // `lint:codespell` reads the Python; this one reads the docs and config
  ["codespell"] {
    glob = List("**/*.md", "**/*.toml")
    exclude = List("**/*.lock")
    check = "codespell {{files}}"
  }

  // CI
  ["yamllint"] = Builtins.yamllint
  ["actionlint"] = Builtins.actionlint
  // actionlint shellchecks workflow scripts only, not the action's own
  ["shellcheck"] = Builtins.shellcheck
}

local all: Mapping<String, Step> = (sweep) {
  // The same tools `mise run lint:py` runs, on the staged files only
  ["black"] = Builtins.black
  ["ruff"] = Builtins.ruff
  ["taplo"] = Builtins.taplo
  ["codespell"] {
    glob = List("**/*.py", "**/*.md", "**/*.toml")
  }
}

// Top-level `steps` would join every hook, `check` included, so each hook
// names its own set.
hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = all
  }
  ["fix"] {
    fix = true
    steps = all
  }
  ["check"] {
    steps = sweep
  }
}
